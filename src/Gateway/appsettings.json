{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": []
  },
  "Jwt": {
    "Key": "",
    "Issuer": "OrderHub",
    "Audience": "OrderHub"
  },
  "ReverseProxy": {
    "Routes": {
      "orders-read": {
        "ClusterId": "orderservice",
        "Match": {
          "Path": "/api/orders/{**catch-all}",
          "Methods": [ "GET" ]
        }
      },
      "orders-write": {
        "ClusterId": "orderservice",
        "Match": {
          "Path": "/api/orders/{**catch-all}"
        },
        "AuthorizationPolicy": "RequireAuthenticated"
      },
      "notifications-read": {
        "ClusterId": "notificationservice",
        "Match": {
          "Path": "/api/notifications/{**catch-all}",
          "Methods": [ "GET" ]
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/notifications" }
        ]
      },
      "notifications-write": {
        "ClusterId": "notificationservice",
        "Match": {
          "Path": "/api/notifications/{**catch-all}"
        },
        "AuthorizationPolicy": "RequireAuthenticated",
        "Transforms": [
          { "PathRemovePrefix": "/api/notifications" }
        ]
      },
      "inventory-read": {
        "ClusterId": "inventoryservice",
        "Match": {
          "Path": "/api/inventory/{**catch-all}",
          "Methods": [ "GET" ]
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/inventory" }
        ]
      },
      "inventory-write": {
        "ClusterId": "inventoryservice",
        "Match": {
          "Path": "/api/inventory/{**catch-all}"
        },
        "AuthorizationPolicy": "RequireAuthenticated",
        "Transforms": [
          { "PathRemovePrefix": "/api/inventory" }
        ]
      }
    },
    "Clusters": {
      "orderservice": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5001"
          }
        }
      },
      "notificationservice": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5002"
          }
        }
      },
      "inventoryservice": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5003"
          }
        }
      }
    }
  }
}
