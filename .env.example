# Copie este arquivo para .env e ajuste os valores antes de rodar docker compose up

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=orderhub

# RabbitMQ
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest

# Connection strings usadas pelos serviços dentro do Docker
ORDER_DB_CONNECTION=Host=postgres;Database=orderhub;Username=postgres;Password=postgres
INVENTORY_DB_CONNECTION=Host=postgres;Database=inventory;Username=postgres;Password=postgres

# Configuração do RabbitMQ para os serviços .NET
RABBITMQ_HOST=rabbitmq
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# URL completa do RabbitMQ para o NotificationService (Node.js)
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
